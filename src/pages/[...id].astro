---
import Index from "@/layouts/index.astro";
import { Picture } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const wikis = await getCollection("wikipages");

  return wikis.map((page) => ({
    params: { id: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const backlinks = page.id.split("/");
const { title, cover } = page.data;
const { Content } = await render(page);

const { BASE_URL, DEV, SITE } = import.meta.env;

const baseURL = new URL(BASE_URL, DEV ? "http://localhost:4321/" : SITE);

const breadcrumb = (index: number, array: string[]) => {
  const r = new URL(baseURL);
  r.pathname += array.slice(0, index + 1).join("/");
  return r;
};

page.rendered;
---

<Index title={title} class="">
  {backlinks.map((crumb, index, array) => (
    <a href={breadcrumb(index, array)} class="mx-4">
      {crumb}
    </a>
  ))}
  <article class="prose prose-pink-orchid prose-invert">
    {cover && (
      <Picture
        alt={`${title} cover`}
        src={cover}
        width={700}
        loading="eager"
        pictureAttributes={{
          title: `${title} Cover Image`,
        }}
      />
    )}
    <h1>{title}</h1>
    <Content />
  </article>
</Index>
